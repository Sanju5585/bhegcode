# ImpEx for Importing Category Media into Powertools Store

# Macros / Replacement Parameter definitions
$productCatalog=bhgeProductCatalog
$productCatalogName=bhgeProductCatalog
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=source(code, $catalogVersion)[unique=true]
$categories=target(code, $catalogVersion)[unique=true]
$erp_catalogVersion = catalogversion(catalog(id[default=ERP_CLASSIFICATION_HYB]),version[default='ERP_IMPORT'])
$thumbnail=thumbnail($erp_catalogVersion,code)
$picture=picture($erp_catalogVersion,code)

$siteResource=jar:com.bhge.initialdata.constants.BhgeInitialDataConstants&/bhgeinitialdata/import/sampledata/productCatalogs/$productCatalog
$lang=en


#images for categories
INSERT_UPDATE Media    ; code[unique=true]  ; realfilename  ; @media[translator=de.hybris.platform.impex.jalo.media.MediaDataTranslator];mime[default='image/jpeg'];$erp_catalogVersion
