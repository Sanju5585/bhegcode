# 
# Import the Powertools Product and Classification Catalogs
#

$productCatalog=bhgeProductCatalog
#$classificationCatalog=bhgeClassification
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$languages=ja,en,de,zh

# Product catalog
INSERT_UPDATE Catalog;id[unique=true]
;$productCatalog

# Product versions for product catalogs
INSERT_UPDATE CatalogVersion;catalog(id)[unique=true];version[unique=true];active;languages(isoCode);readPrincipals(uid)
;$productCatalog;Staged;false;$languages;employeegroup
;$productCatalog;Online;true;$languages;employeegroup

# Powertools Classification catalog
#INSERT_UPDATE ClassificationSystem;id[unique=true]
#;$classificationCatalog

# Insert Classifications System Version
#INSERT_UPDATE ClassificationSystemVersion;catalog(id)[unique=true];version[unique=true];active;inclPacking[virtual=true,default=true];inclDuty[virtual=true,default=true];inclFreight[virtual=true,default=true];inclAssurance[virtual=true,default=true]
#;$classificationCatalog;1.0;true

# Create default tax row for all products in product catalog
INSERT_UPDATE TaxRow;$catalogVersion;tax(code)[unique=true];pg(code)[unique=true];ug(code)[unique=true]
;;us-sales-tax-full;us-sales-tax-full;us-taxes
;;ca-sales-tax-full;ca-sales-tax-full;ca-taxes

# ERP_CLASSIFICATION_HYB Classification catalog
$ERP_classificationCatalog=ERP_CLASSIFICATION_HYB

INSERT_UPDATE ClassificationSystem;id[unique=true]
;$ERP_classificationCatalog

# Insert Classifications System Version
INSERT_UPDATE ClassificationSystemVersion;catalog(id)[unique=true];version[unique=true];active;inclPacking[virtual=true,default=true];inclDuty[virtual=true,default=true];inclFreight[virtual=true,default=true];inclAssurance[virtual=true,default=true]
;$ERP_classificationCatalog;ERP_IMPORT;true

$serviceProductCatalog=bhgeServiceProductCatalog
$catalogVersion=catalogversion(catalog(id[default=$serviceProductCatalog]),version[default='Staged'])[unique=true,default=$serviceProductCatalog]
$languages=ja,en,de,zh

# Product catalog
INSERT_UPDATE Catalog;id[unique=true]
;$serviceProductCatalog

# Product versions for product catalogs
INSERT_UPDATE CatalogVersion;catalog(id)[unique=true];version[unique=true];active;languages(isoCode);readPrincipals(uid)
;$serviceProductCatalog;Staged;false;$languages;employeegroup
;$serviceProductCatalog;Online;true;$languages;employeegroup

"#% impex.info(""###############   BHGE catalog.impex  -start  ################"")"
#
# Import the Product Catalog and Classification Catalog
#

$1720_productCatalog=1720_GE
$catalogVersion=catalogversion(catalog(id[default=$1720_productCatalog]),version[default='Staged'])[unique=true,default=$1720_productCatalog:Staged]
$languages=en
$sourceProductCV=sourceVersion(catalog(id[default=$1720_productCatalog]),version[default='Staged'])[unique=true,default='$1720_productCatalog:Staged']
$targetProductCV=targetVersion(catalog(id[default=$1720_productCatalog]),version[default='Online'])[unique=true,default='$1720_productCatalog:Online']

# 1720 Product Catalog
INSERT_UPDATE Catalog;id[unique=true];name
;$1720_productCatalog;1720 GE Product Catalog

# Product versions for product catalogs
INSERT_UPDATE CatalogVersion;catalog(id)[unique=true];version[unique=true];active;languages(isoCode);readPrincipals(uid);writePrincipals(uid);
;$1720_productCatalog;Staged;false;$languages;employeegroup;productmanagergroup;
;$1720_productCatalog;Online;true;$languages;employeegroup;productmanagergroup;

INSERT_UPDATE CatalogVersionSyncJob;code[unique=true];$sourceProductCV;$targetProductCV;
;1720_GEProductCatalog_StagedToOnlineSync;;;;


