# ImpEx for Importing Category Classifications 
$classCatalogVersion=catalogversion(catalog(id[default='ERP_CLASSIFICATION_HYB']),version[default='ERP_IMPORT'])[unique=true,default='ERP_CLASSIFICATION_HYB:ERP_IMPORT']
$classSystemVersion=systemVersion(catalog(id[default='ERP_CLASSIFICATION_HYB']),version[default='ERP_IMPORT'])[unique=true]

# Insert Classifications
# Portable Instruments --- ECOM_LVL2_00000001  ECOM_LVL2_00000001
# ET Probes --- ECOM_LVL2_00000002  ECOM_LVL2_00000002
# UT Probes --- ECOM_LVL2_00000003  ECOM_LVL2_00000003
# FILM PRODUCTS --- ECOM_LVL2_00000004  ECOM_LVL2_00000004
# Safety Valves FPT Category --- ECOM_LVL2_00000006  ECOM_LVL2_00000007
# Safety Relief Valves FPT Category --- ECOM_LVL2_00000007  ECOM_LVL2_00000008
# Pilot Oper Srv FPT Category--- ECOM_LVL2_00000008  ECOM_LVL2_00000009

# Remote Visual Inspection(RVI) --- ECOM_LVL3_00000001  ECOM_LVL3_00000001
# Ultrasonic-Flaw Detectors --- ECOM_LVL3_00000002  ECOM_LVL3_00000002
# Eddy Current --- ECOM_LVL3_00000003   ECOM_LVL3_00000003
# Ultrasonic-Thickness Gauges --- ECOM_LVL3_00000004  ECOM_LVL3_00000004
# Ultrasonic-Phased Array ---- ECOM_LVL3_00000005  ECOM_LVL3_00000005
# Ultrasonic-Hardness --- ECOM_LVL3_00000006  ECOM_LVL3_00000006

