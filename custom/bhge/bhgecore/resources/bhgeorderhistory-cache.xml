	<!-- <bean id="orderHistoryCacheRegionRegistrar" class="de.hybris.platform.regioncache.region.CacheRegionRegistrar" 
			c:region-ref="orderHistoryCacheRegion" /> -->
			
	 <!-- Add the cache region to the available cache regions list -->
    <bean class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="cacheRegionsList"/>
        <property name="targetMethod" value="add"/>
        <property name="arguments">
            <ref bean="orderHistoryCacheRegion" />
        </property>
    </bean>
    
    
    <bean class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="cacheRegionsList"/>
        <property name="targetMethod" value="add"/>
        <property name="arguments">
            <ref bean="rmaStatusCacheRegion" />
        </property>
    </bean>

     <alias alias="entityCacheRegion" name="ehCacheEntityCacheRegion"/>
    <bean name="ehCacheEntityCacheRegion" class="de.hybris.platform.regioncache.region.impl.DefaultCacheRegion" lazy-init="true">
        <constructor-arg name="name" value="entityCacheRegion"/>
        <constructor-arg name="maxEntries" value="#{100000 * ( T(java.lang.Runtime).runtime.maxMemory() / ( 1024 * 1024 * 1024 * 4.0 ) )  }"/>
        <!--<constructor-arg name="evictionPolicy" value="${regioncache.entityregion.evictionpolicy}"/>-->
        <constructor-arg name="statsEnabled" value="${regioncache.stats.enabled}" />
        <constructor-arg name="exclusiveComputation" value="${regioncache.exclusivecomputation}"/>
        <property name="handledTypes">
            <array>
                <value>__ALL_TYPES__</value>
                <value>__NO_QUERY__</value>
            </array>
        </property>
    </bean>

