"#% impex.setTargetFile( ""GEEDGECustomer.csv"", true, 1, -1 );"
UPDATE GEEDGECustomer;pk[unique=true];uid;name;email;creationtime[dateformat='yyyy-MM-dd'];modifiedtime[dateformat='yyyy-MM-dd'];sapContactID;customerID;isInternalUser;groups(uid)[mode=append]
