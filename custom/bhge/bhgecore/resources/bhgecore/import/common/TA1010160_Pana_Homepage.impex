                                    ;;SiteLogo-PanaHomepage;SiteLogo;;SiteLogoSlot;true
                                    ;;HomepageLink-PanaHomepage;HomepageNavLink;;HomepageNavLinkSlot;true
                                    ;;NavigationBar-PanaHomepage;NavigationBar;;NavigationBarSlot;true
