$contentCatalog=bhgeContentCatalog
$contentCatalogName=bhgeContentCatalog
$productCatalogName=bhgeGlobalProductCatalog
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Online])[default=$contentCatalog:Online]
$productCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$productCatalogName]),CatalogVersion.version[default=Online])[default=$productCatalogName:Online]

$panaBannerTitle1=Welcome to Panametrics
$panaBannerContent1=We offer solutions for measuring and analyzing moisture, oxygen, liquid, steam, and gas flow with proven technologies that are well-known and widely deployed across many industries, including oil and gas.
$panaBannerTitle2=Panametrics
$panaBannerContent2=Measurements that matter
$panaNewArrivalTitle1=Panametrics launches HygroPro XP, the most advanced moisture transmitter
$panaNewArrivalContent1=HygroPro XP is the latest addition to the Panametrics portfolio of market
$panaNewArrivalTitle2=PanaFlow XMT1000
$panaNewArrivalContent2=The PanaFlow XMT1000 is an ultrasonic flow transmitter for liquids
$panaFeaturedProducts=PF10-Z3,PT9-TABLET-17,HYGROPROII,MOISTURE.IQ
$panaBestSellerProducts=OXY.IQ,AT6,DEW.IQ


