    <style>
        li.class, li.collapsed, li.expanded {
            list-style-image: none;
            list-style: none;
            list-style-type: none;
        }
        ul {
            list-style: none;
            list-style-type: none;
            margin-top: auto;
            margin-left: auto;
            margin-right: auto;
            margin-bottom: auto
        }
        li {
            list-style: none;
            list-style-type: none;
        }
        .w-100 {
            align:center
        }
        ul li {
            list-style:none;
            margin-bottom: 10px;
            list-style: none;
            list-style-type: none;
        }
        ul {
            padding-left: 0;
            list-style: none;
            list-style-type: none;
        }
        .text-bold {
            font-weight: bold;
        }
        .t-border {
            border-collapse: collapse;
        }
        .t-border tr td {
            border: 1px solid black;
            padding:20px;
        }
        .t-b-none tr td {
            border: none;
            padding: 0px;
            padding-bottom: 10px;
        }

    </style>
