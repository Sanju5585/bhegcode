               <h1 class="header h1" style="margin: 20px 0; line-height: 40px; font-family: 'Poppins','Lucida Sans'; text-align: left; color: #05322B; font-size: 24px; margin-left: 0; margin-top: -40px;">
                Order Share
               </h1>
               </td>
               </tr>
     </table>
   </div>
  
    <p style="width: 90%; margin: auto; margin-bottom: 20px;">Dear Customer,<br>Please review your Order details below.</p>

    <table style="width: 90%; margin: auto; margin-bottom: 20px;">
        <tr>
            <td>Order Number #<span style="float:right;">:</span></td>
            <td> <strong style="color: #13294b;"> $ctx.orderHeaderData.code</strong></td>
        </tr>
        <tr>
            <td>Customer PO#<span style="float:right;">:</span></td>
            <td> <strong style="color: #13294b;">  $ctx.orderHeaderData.purchaseOrderNumber</strong></td>
        </tr>
        <tr>
            <td>Date Order Created<span style="float:right;">:</span></td>
            #if(${ctx.orderHeaderData.orderDate})
            <td> <strong style="color: #13294b;">  $ctx.orderHeaderData.orderDate</strong></td>
            #else
            <td> <strong style="color: #13294b;">  </strong></td>
            #end
        </tr>
        <tr>
            <td>Sold To Customer<span style="float:right;">:</span></td>
            <td> <strong style="color: #13294b;"> $ctx.orderHeaderData.soldTo</strong></td>
        </tr>
        <!--<tr>
            <td>Return-to Site<span style="float:right;">:</span></td>
            <td> <strong style="color: #13294b;"> $ctx.orderHeaderData.returnSite</strong></td>
        </tr>-->
        #if(${ctx.orderHeaderData.headerShippingAddress})
        <tr>
            <td style="vertical-align:top">Ship-To <span style="float:right;">:</span></td>
            <td><strong style="color: #13294b;"> $ctx.orderHeaderData.headerShippingAddress</strong></td>
        </tr> 
        #else         
        <tr>

        </tr>
        #end
    </table>


	
#foreach( $itemdata in $ctx.orderHeaderData.lineData ) 	




