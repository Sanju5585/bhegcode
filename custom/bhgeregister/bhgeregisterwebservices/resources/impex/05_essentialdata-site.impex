
$contentCatalog=bhgeRegisterContentCatalog
$productCatalog=bhgeRegisterProductCatalog
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Staged])[default=$contentCatalog:Staged]
$defaultLanguage=en
$storeUid=bhgeRegister
$siteUid=bhgeRegister
$webServiceSiteUid=$siteUidWS
$siteMapLangCur=jaCad,jaUsd,enCad,enUsd,deCad,deUsd,zhCad,zhUsd
$siteMapUrlLimitPerFile=50000
$siteMapPage=Homepage
$customSiteMapUrls=
$lang=en

# Load the storefront context root config param
$storefrontContextRoot=/bhgeRegister

# Import config properties into impex macros
INSERT_UPDATE GenericItem[processor=de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor];pk[unique=true]

# Import modulegen config properties into impex macros
$jarResource=$config-jarResource

# Load the storefront context root config param
$storefrontContextRoot=$config-storefrontContextRoot

INSERT_UPDATE ContentPage;$contentCV[unique=true];uid[unique=true];name;masterTemplate(uid,$contentCV);label;defaultPage[default='true'];approvalStatus(code)[default='approved'];homepage[default='false']
;;registerHomepage;RegisterHomepage;BHGERegisterPageTemplate;registerHomepage

# CMS Site
INSERT_UPDATE CMSSite;uid[unique=true];name;theme(code);channel(code);stores(uid);contentCatalogs(id);defaultCatalog(id);defaultLanguage(isoCode);urlPatterns;active;previewURL;startingPage(uid,$contentCV);urlEncodingAttributes;defaultPromotionGroup(Identifier)[default=bhgePromoGrp];cartRemovalAge
;$siteUid;BHGE Global Customer Support;lambda;B2B;$storeUid;$contentCatalog;$productCatalog;$defaultLanguage;(?i)^https?://[^/]+(/[^?]*)?\?(.*\&)?(site=$siteUid)(|\&.*)$,(?i)^https?://$siteUid\.[^/]+(|/.*|\?.*)$,(?i)^https?://[^/]*/homeRegister.*,(?i)^https?://[^/]*/loginRegister.*;true;$storefrontContextRoot/?site=$siteUid;registerHomepage;;;2419200

# Create CMS Site
INSERT_UPDATE CMSSite;uid[unique=true];name[lang=$lang];locale[lang=$lang]
;$siteUid;"BHGE Register Site";en_GB

# SiteMap Configuration
# SiteMap Language Currencies
INSERT_UPDATE SiteMapLanguageCurrency;&siteMapLanguageCurrency;language(isoCode)[unique=true];currency(isocode)[unique=true];
;enUsd;en;USD
;enCad;en;CAD
;jaUsd;ja;USD
;jaCad;ja;CAD
;deUsd;de;USD
;deCad;de;CAD
;zhUsd;zh;USD
;zhCad;zh;CAD

INSERT_UPDATE CatalogUnawareMedia;&siteMapMediaId;code[unique=true];realfilename;@media[translator=de.hybris.platform.impex.jalo.media.MediaDataTranslator];mime[default='text/plain']
;$siteUid-siteMapMedia;$siteUid-siteMapMedia;siteMapTemplate.vm;$jarResource/site-siteMapTemplate.vm;

INSERT_UPDATE RendererTemplate;&siteMapRenderer;code[unique=true];content(&siteMapMediaId);contextClass;rendererType(code)[default='velocity'];
;$siteUid-siteMapTemplate;$siteUid-siteMapTemplate;$siteUid-siteMapMedia;de.hybris.platform.acceleratorservices.sitemap.renderer.SiteMapContext;

# CMS Site
INSERT_UPDATE CMSSite;uid[unique=true];previewURL
;$siteUid;$storefrontContextRoot/?site=$siteUid
