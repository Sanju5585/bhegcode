
$contentCatalog=bhgeRegisterContentCatalog
$productCatalog=bhgeRegisterProductCatalog
#$classificationCatalog=bhgeRegisterClassification
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$sourceProductStaged=sourceVersion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default='$productCatalog:Staged']
$targetProductOnline=targetVersion(catalog(id[default=$productCatalog]),version[default='Online'])[unique=true,default='$productCatalog:Online']
$sourceContentStaged=sourceVersion(catalog(id[default=$contentCatalog]),version[default='Staged'])[unique=true,default='$contentCatalog:Staged']
$targetContentOnline=targetVersion(catalog(id[default=$contentCatalog]),version[default='Online'])[unique=true,default='$contentCatalog:Online']

$languages=ja,en,de,zh
$lang=en

# Content catalog for CMS contents
INSERT_UPDATE ContentCatalog;id[unique=true]
;$contentCatalog

# Catalog versions for content catalogs
INSERT_UPDATE CatalogVersion;catalog(id)[unique=true];version[unique=true];active;languages(isoCode)
;$contentCatalog;Staged;false;$languages
;$contentCatalog;Online;true;$languages

# Create Content Catalog Name
INSERT_UPDATE ContentCatalog;id[unique=true];name[lang=$lang]
 ;bhgeContentCatalog;"bhgeContentCatalog"

# Product catalog
INSERT_UPDATE Catalog;id[unique=true]
;$productCatalog

# Product versions for product catalogs
INSERT_UPDATE CatalogVersion;catalog(id)[unique=true];version[unique=true];active;languages(isoCode);readPrincipals(uid)
;$productCatalog;Staged;false;$languages;employeegroup
;$productCatalog;Online;true;$languages;employeegroup

# Powertools Classification catalog
INSERT_UPDATE ClassificationSystem;id[unique=true]
;$classificationCatalog

# Insert Classifications System Version
INSERT_UPDATE ClassificationSystemVersion;catalog(id)[unique=true];version[unique=true];active;inclPacking[virtual=true,default=true];inclDuty[virtual=true,default=true];inclFreight[virtual=true,default=true];inclAssurance[virtual=true,default=true]
;$classificationCatalog;1.0;true

#Sync Product Catalog Staged to Online
INSERT_UPDATE CatalogVersionSyncJob;code[unique=true];$sourceProductStaged;$targetProductOnline;
;sync $productCatalog:Staged->Online;;;;

#Sync Content Catalog Staged to Online
INSERT_UPDATE CatalogVersionSyncJob;code[unique=true];$sourceContentStaged;$targetContentOnline;
;sync $contentCatalog:Staged->Online;;;;

