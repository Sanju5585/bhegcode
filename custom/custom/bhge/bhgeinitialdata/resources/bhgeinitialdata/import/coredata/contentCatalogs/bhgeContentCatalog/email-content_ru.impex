 # Email templates:
 
 "#% impex.info(""###############    email_template.impex  -start  ################"")"
#
# Import the Order History Email Content Catalog
#
$contentCatalog=bhgeContentCatalog
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default='Staged'])[default=$contentCatalog:Staged]
$jarResourceCms=jar:com.bhge.core.setup.CoreSystemSetup&/bhgecore/import/cockpits/cmscockpit
$emailResourcePath=$jarResourceCms/structure-view
$bhgeEmailResourcePath=$jarResourceCms/structure-view/email-templates
$emailResource=$jarResourceCms/structure-view
 
# Language
$lang=en
 
# Order Email Template
INSERT_UPDATE Media;code[unique=true];$contentCV[unique=true];mime;realfilename;@media[translator=de.hybris.platform.impex.jalo.media.MediaDataTranslator];
;bhgeCriticalErrorMailTemplate_media;;text/html;bhgeCriticalErrorEmailTemplate.vm;$bhgeEmailResourcePath/orderTemplates/bhgeCriticalErrorEmailTemplate.vm
;bhgeRFCFailureMailTemplate_media;;text/html;bhgeRFCFailureMail.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeRFCFailureMail.vm
;bhgeInvalidDataReportMailTemplate_media;;text/html;bhgeInvalidDataReportMail.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeInvalidDataReportMail.vm
;bhgeWeeklyOrderReportMailTemplate_media;;text/html;bhgeWeeklyOrderReportMail.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeWeeklyOrderReportMail.vm
;bhgeMaterialPushMailTemplate_media;;text/html;bhgeMaterialPushEmailTemplate.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeMaterialPushEmailTemplate.vm
;bhgeNonCriticalErrorMailTemplate_media;;text/html;bhgeNonCriticalErrorDetails.vm;$bhgeEmailResourcePath/orderTemplates/bhgeNonCriticalErrorDetails.vm
;bhgeOrderConfEmailFailureTemplate_media;;text/html;bhgeOrderConfEmailFailureTemplate.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeOrderConfEmailFailureTemplate.vm
;bhgeActiveUsersEmailTemplate_media;;text/html;bhgeactiveUsersEmailTemplate.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeactiveUsersEmailTemplate.vm
;bhgePendingActivationUsersReportMailTemplate_media;;text/html;bhgePendingActivationUsersReportMail.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgePendingActivationUsersReportMail.vm
;bhgeInactiveUsersReportMailTemplate_media;;text/html;bhgeInactiveUsersReportMail.vm;$bhgeEmailResourcePath/adminEmailTemplates/bhgeInactiveUsersReportMail.vm


# Renderer Templates
