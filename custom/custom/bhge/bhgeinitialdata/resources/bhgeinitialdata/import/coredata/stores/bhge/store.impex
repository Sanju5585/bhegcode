# GEEDGE B2B Base Store
INSERT_UPDATE BaseStore;uid[unique=true,allownull=true];Name;catalogs(id)[default=$productCatalog];defaultLanguage(isocode);expressCheckoutEnabled[allownull=true];externalTaxEnabled[allownull=true];maxRadiusForPoSSearch;net[allownull=true];paymentProvider;storelocatorDistanceUnit(code,itemtype(code));submitOrderProcessCode;taxEstimationEnabled[allownull=true]
;5010_BaseStore;5010 BN Base Store;$bhgeGlobalProductCatalog;en;TRUE;FALSE;100;FALSE;Mockup;miles:DistanceUnit;order-process;FALSE

UPDATE BaseStore;uid[unique=true];defaultCurrency(isocode);currencies(isocode);name;languages(isocode)
;5010_BaseStore;INR;INR;GEIIPL,Div-BN,Mumbai;en,de,zh,es,pt

# SAP Base Store Configurations
INSERT_UPDATE SAPConfiguration;SAPRFCDestination(rfcDestinationName);core_name[unique=true];sapcommon_distributionChannel;sapcommon_division;sapcommon_salesOrganization;sapcommon_transactionType;sappricingbol_cartPricing[default=false];sappricingbol_catalogPricing[default=false];sappricingbol_cachePrice[default=false]
;$rfcDestination;5010_BaseStoreConfiguration;BN;BN;5010;ZOR;;;;

# Base Store and Configurations Mappings
INSERT_UPDATE BaseStore;uid[unique=true,allownull=true];Name;SAPConfiguration(core_name);defaultLanguage(isocode);expressCheckoutEnabled[allownull=true];externalTaxEnabled[allownull=true];maxRadiusForPoSSearch;net[allownull=true];paymentProvider;storelocatorDistanceUnit(code,itemtype(code));submitOrderProcessCode;taxEstimationEnabled[allownull=true];languages(isocode);checkoutFlowGroup
;5010_BaseStore;GEIIPL,Div-BN,Mumbai;5010_BaseStoreConfiguration;en;TRUE;FALSE;100;FALSE;Mockup;miles:DistanceUnit;order-process;FALSE;en,zh,es,de,pt;b2bCheckoutGroup

INSERT_UPDATE ReferenceDistributionChannelMapping;salesOrganization[unique=true];distChannel[unique=true];distChannelName[lang=en];refDistChannelCustMat;refDistChannelConditions
;5010;BN;;"BN Dist Channel";BN;BN;

INSERT_UPDATE ReferenceDivisionMapping;salesOrganization[unique=true];division[unique=true];divisionName[lang=en];refDivisionCustomer;refDivisionConditions
;5010;BN;;"BN Dist Channel";BN;BN;

#Material - SalesArea To Catalog Mapping
INSERT_UPDATE SAPProductSalesAreaToCatalogMapping;catalogVersion(catalog(id),version);distributionChannel[unique=true];salesOrganization[unique=true];sapGlobalConfiguration(core_name);taxClassCountry(isocode)
;5010_BN:Staged;BN;5010;GLOBAL;IN;

#List Price - SalesArea To Catalog Mapping
INSERT_UPDATE SAPPricingSalesAreaToCatalog;catalogVersion(catalog(id),version);distributionChannel[unique=true];salesOrganization[unique=true];sapcommon_sapGlobalConfiguration(core_name);
;5010_BN:Staged;BN;5010;GLOBAL;

