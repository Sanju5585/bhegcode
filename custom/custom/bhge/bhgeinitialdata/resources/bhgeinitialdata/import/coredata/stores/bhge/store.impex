# 
# Create the BHGE BaseStore
#

$productCatalog=bhgeProductCatalog
#$classificationCatalog=bhgeClassification
$currencies=USD
$net=true
$storeUid=bhge
$defaultCurrency=USD
$languages=ja,en,de,zh
$defaultLanguage=en
$unitedKingdom=GB,GG,IM,JE
$europeNotUK=AD,AL,AT,BA,BE,BG,BY,CH,CY,CZ,DE,DK,EE,ES,FI,FO,FR,GI,GL,GR,HR,HU,IE,IS,IT,LI,LT,LU,LV,MC,MD,ME,MK,MT,NL,NO,PL,PT,RO,RS,RU,SE,SI,SK,SM,TR,UA,VA
$asianCountries=CN,JP,VN,HK,KP,KR,IN
$deliveryCountries=$unitedKingdom,$europeNotUK,$asianCountries,US,CA
$orderProcessCode=order-process
$pickupInStoreMode=DISABLED
$customerAllowedToIgnoreSuggestions=true
$paymentProvider=Mockup
$expressCheckoutEnabled=false
$checkoutGroup=b2bCheckoutGroup
$returnProcessCode=return-process
$siteUid=bhge
$facetSearchConfigName=bhgeIndex
$defaultLanguage=en

#Service Macros
$serviceProductCatalog=bhgeServiceProductCatalog
$serviceStoreUid=bhgeService

#Global Catalog
$bhgeGlobalProductCatalog=bhgeGlobalProductCatalog

INSERT_UPDATE PromotionGroup;Identifier[unique=true];
;bhgePromoGrp;

# Base Store
INSERT_UPDATE BaseStore;uid[unique=true];catalogs(id);currencies(isocode);net;taxGroup(code);storelocatorDistanceUnit(code);defaultCurrency(isocode);languages(isocode);defaultLanguage(isocode);deliveryCountries(isocode);submitOrderProcessCode;paymentProvider;pickupInStoreMode(code);customerAllowedToIgnoreSuggestions;expressCheckoutEnabled;maxRadiusForPoSSearch;checkoutFlowGroup;createReturnProcessCode;
;$storeUid;$bhgeGlobalProductCatalog;$currencies;$net;us-taxes;miles;$defaultCurrency;$languages;$defaultLanguage;$deliveryCountries;$orderProcessCode;$paymentProvider;$pickupInStoreMode;$customerAllowedToIgnoreSuggestions;$expressCheckoutEnabled;300;$checkoutGroup;$returnProcessCode;

INSERT_UPDATE BaseStore2DeliveryModeRel;source(uid)[unique=true];target(code)[unique=true]
;$storeUid;premium-net
;$storeUid;standard-net
;$storeUid;premium-gross
;$storeUid;standard-gross
;$storeUid;free-standard-shipping

# Base Store
INSERT_UPDATE BaseStore;uid[unique=true];catalogs(id);currencies(isocode);net;taxGroup(code);storelocatorDistanceUnit(code);defaultCurrency(isocode);languages(isocode);defaultLanguage(isocode);deliveryCountries(isocode);submitOrderProcessCode;paymentProvider;pickupInStoreMode(code);customerAllowedToIgnoreSuggestions;expressCheckoutEnabled;maxRadiusForPoSSearch;checkoutFlowGroup;createReturnProcessCode;
;$serviceStoreUid;$serviceProductCatalog;$currencies;$net;us-taxes;miles;$defaultCurrency;$languages;$defaultLanguage;$deliveryCountries;$orderProcessCode;$paymentProvider;$pickupInStoreMode;$customerAllowedToIgnoreSuggestions;$expressCheckoutEnabled;300;$checkoutGroup;$returnProcessCode;

INSERT_UPDATE BaseStore2DeliveryModeRel;source(uid)[unique=true];target(code)[unique=true]
;$serviceStoreUid;premium-net
;$serviceStoreUid;standard-net
;$serviceStoreUid;premium-gross
;$serviceStoreUid;standard-gross
;$serviceStoreUid;free-standard-shipping

"#% impex.info(""###############   BHGE B2B Base Store store.impex  -start  ################"")"

# Import config properties into impex macros
UPDATE GenericItem[processor=de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor];pk[unique=true]

## This Impex is for SAP and other Integration related configuration ##

#SAP Integration
INSERT_UPDATE SAPGlobalConfiguration;core_name[unique=true];replicateregistereduser[allownull=true];sapcommon_erpHttpDestination(httpDestinationName);sapcommon_erpLogicalSystem
;GLOBAL;false;;

# Import config properties into impex macros
INSERT_UPDATE GenericItem[processor=de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor];pk[unique=true]
$rfcDestination=$config-SAP_RFC_SERVER_NAME
$rfcDestinationInstance=$config-SAP_RFC_SERVER_INSTANCE
$rfcDestinationClient=$config-SAP_RFC_SERVER_CLIENT
$rfcHttpDestination=$config-SAP_RFC_HTTP_DESTINATION
$rfcTargethost=$config-SAP_RFC_TARGET_HOST


#SAP HTTP Destination
INSERT_UPDATE SAPHTTPDESTINATION;HTTPDESTINATIONNAME[unique=true];TARGETURL;AUTHENTICATIONTYPE(code);USERID;PASSWORD
;$rfcDestination;$rfcHttpDestination=$rfcDestinationClient;BASIC_AUTHENTICATION;EORDER;Weborder@123;


#SAP RFC Destination
INSERT_UPDATE SAPRFCDestination;RFCDESTINATIONNAME[unique=true];TARGETHOST;BACKENDTYPE(code);INSTANCE;CONNECTIONTYPE;CLIENT;USERID;PASSWORD;OFFLINEMODE;JCOTRACELEVEL(code);
;$rfcDestination;$rfcTargethost;ERP;$rfcDestinationInstance;true;$rfcDestinationClient;EORDER;Weborder@123;false;ERRORS;

