#
# Import the Solr configuration for the Powertools store
#
$productCatalog=bhgeProductCatalog
$serviceProductCatalog=bhgeServiceProductCatalog
$catalogVersions=catalogVersions(catalog(id),version);
$facetSearchConfigName=bhgeIndex
$facetSearchConfigDescription=BHGE Solr Index
$searchIndexNamePrefix=bhge
$solrIndexedType=bhgeProductType
$indexBaseSite=bhge
$indexLanguages=en,de,zh,es,pt
$indexCurrencies=USD,CAD
$classificationCatalog=ERP_CLASSIFICATION_HYB:ERP_IMPORT
$classSystemVersion=systemVersion(catalog(id[default='ERP_CLASSIFICATION_HYB']),version[default='ERP_IMPORT'])
$classCatalogVersion=catalogVersion(catalog(id[default='ERP_CLASSIFICATION_HYB']),version[default='ERP_IMPORT'])
$classAttribute=classificationAttribute(code,$classSystemVersion)
$classClass=classificationClass(code,$classCatalogVersion)
$classAttributeAssignment=classAttributeAssignment($classClass,$classAttribute,$classSystemVersion)
$serverConfigName=BHGESolrServerConfig
$indexConfigName=BHGESolrIndexConfig
$searchConfigName=BHGEPageSize
$siteUid=bhge
$storeUid=bhge
$serviceStoreUid=bhgeService

#
# Setup the indexed types, their properties, and the update queries
#

# Import config properties into impex macros
INSERT_UPDATE GenericItem[processor=de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor];pk[unique=true]
$solrServerURL=$config-solrServerURL

#
# Setup the Solr server, indexer, and search configs
#
# Creates the Solr server configurations
INSERT_UPDATE SolrServerConfig ; name[unique=true] ; mode(code) ; username   ; password  ; indexingUsername   ; indexingPassword ;solrQueryMethod(code)
                               ; $serverConfigName ; standalone ; solrclient ; client123 ; solrindexingclient ; indexingclient123;POST


INSERT_UPDATE SolrEndpointUrl;url[unique=true];master;solrServerConfig(name)[unique=true];
;https://localhost:8983/solr;false;Default;
;$solrServerURL;true;$serverConfigName;

INSERT_UPDATE SolrIndexConfig ; name[unique=true] ; batchSize ; numberOfThreads
                              ; $indexConfigName ; 100       ; 5     

# Updates the search configurations

INSERT_UPDATE SolrSearchConfig ; description[unique=true] ; pageSize;legacyMode[default=true]
                               ; $searchConfigName        ; 20   
                               
                               

# Declare the indexed type Product
INSERT_UPDATE SolrIndexedType;identifier[unique=true];type(code);variant;sorts(&sortRefID)
;$solrIndexedType;GEEdgeProduct;false;sortRef1,sortRef3,sortRef4

INSERT_UPDATE SolrFacetSearchConfig;name[unique=true];description;indexNamePrefix;languages(isocode);currencies(isocode);solrServerConfig(name);solrSearchConfig(description);solrIndexConfig(name);solrIndexedTypes(identifier);enabledLanguageFallbackMechanism;$catalogVersions
;$facetSearchConfigName;$facetSearchConfigDescription;$searchIndexNamePrefix;$indexLanguages;$indexCurrencies;$serverConfigName;$searchConfigName;$indexConfigName;$solrIndexedType;true;$productCatalog:Online,$productCatalog:Staged,$serviceProductCatalog:Online,$serviceProductCatalog:Staged,$classificationCatalog

UPDATE BaseSite;uid[unique=true];solrFacetSearchConfiguration(name)
;$indexBaseSite;$facetSearchConfigName

# Define price range set
INSERT_UPDATE SolrValueRangeSet;name[unique=true];qualifier;type;solrValueRanges(&rangeValueRefID)
;bhgePriceRangeUSD;USD;double;rangeRefUSD1,rangeRefUSD2,rangeRefUSD3,rangeRefUSD4,rangeRefUSD5
;bhgePriceRangeCAD;CAD;double;rangeRefCAD1,rangeRefCAD2,rangeRefCAD3,rangeRefCAD4,rangeRefCAD5

# Define price ranges
INSERT_UPDATE SolrValueRange;&rangeValueRefID;solrValueRangeSet(name)[unique=true];name[unique=true];from;to
;rangeRefUSD1;bhgePriceRangeUSD;      $0-$49.99;   0;  49.99
;rangeRefUSD2;bhgePriceRangeUSD;    $50-$199.99;  50; 199.99
;rangeRefUSD3;bhgePriceRangeUSD;   $200-$499.99; 200; 499.99
;rangeRefUSD4;bhgePriceRangeUSD;   $500-$999.99; 500; 999.99
;rangeRefUSD5;bhgePriceRangeUSD;$1,000-$100,000;1000; 100000

;rangeRefCAD1;bhgePriceRangeCAD;      C$0-C$49.99;   0;  49.99
;rangeRefCAD2;bhgePriceRangeCAD;    C$50-C$199.99;  50; 199.99
;rangeRefCAD3;bhgePriceRangeCAD;   C$200-C$499.99; 200; 499.99
;rangeRefCAD4;bhgePriceRangeCAD;   C$500-C$999.99; 500; 999.99
;rangeRefCAD5;bhgePriceRangeCAD;C$1,000-C$100,000;1000; 100000

