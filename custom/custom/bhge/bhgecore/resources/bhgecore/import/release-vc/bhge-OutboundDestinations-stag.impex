                      ; scpiOrderEndpoint             ; unknown               ; "$orderUrl;$orderVersion/"             ; scpiOrderEndpoint


#***  Destination Target  ***#

INSERT_UPDATE DestinationTarget; id[unique = true]
                               ; scpiDestinationTarget


#***  Consumed Destinations  ***#

INSERT_UPDATE ConsumedDestination; id[unique = true]                ; url                                                                    ; endpoint(id, version)                 ; credential(id)      		; additionalProperties(key, value)[map-delimiter = |]; destinationTarget(id)[default = scpiDestinationTarget]; active[default = true]
                                 ; scpiOrderDestination             ; "$orderUrl;$orderVersion/SAPCpiOutboundOrders"                         ; scpiOrderEndpoint:unknown             ; scpiOauthCredentialNew 	; "csrfURL->$orderUrl;$orderVersion/"                ;

