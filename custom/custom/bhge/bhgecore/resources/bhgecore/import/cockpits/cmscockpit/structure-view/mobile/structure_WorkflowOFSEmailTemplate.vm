<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopBakerHughes</title>
    <style>
        a {
            color: #121212 !important;
        }

        .button {
            background-color: #02A783;
            border-radius: 4px;
            padding: 10px 22px;
            text-align: center;
            text-decoration: none;
            font-size: 12px;
            margin: 2px 0px;
            cursor: pointer;
            font-family: Poppins;
            color: #FFFFFF !important;
        }

        .container {
            margin-left: 5%;
        }

        .img-center {
            margin-left: 25%;
        }

        .content {
            border: 1px solid #E2E2E2;
            margin-right: 25%;
            margin-left: 15%;
            background-image: url("$ctx.bhgeBasePath/assets/_ui/responsive/theme-lambda/images/OFS_Email_Background.png");
            background-repeat: no-repeat;
            background-position-x: 350px;
            background-position-y: 10px;
            background-size: 50%;
        }

        p {
            font-size: 18px;
            font-family: Poppins !important;
            font-style: Regular;
            line-height: 20x;
            color: #121212;
        }

        h5 {
            text-align: center;
            font-size: 24px;
            color: #506C65;
        }

        @media only screen and (max-width: 850px) {
            p {
                font-size: 16px;
            }

            h5 {
                font-size: 18px;
                color: #506C65;
            }

            .responsive-img {
                width: 202px;
                height: 60px;
            }

            .content {
                border: none;
                background-color: #E5E5E5
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="content">
            <div class="img-center" style="margin-bottom: 7px;">
                <img src="$ctx.bhgeBasePath/assets/_ui/responsive/theme-lambda/images/OFS_Email_Header.png" width="383px" height="112px"
                    class="responsive-img" />
            </div>
            <h5>Registration Successful</h5>


            <div class="container " style="margin-top:6px">
                <h6 style="margin-top: 5%; font-size: 18px;"><strong>Dear ${ctx.userName},</strong> </h6>
                <p>You are now registered to use the ShopBakerHughes. Welcome!</p>
                <a href="${ctx.companyEmail}" class="button">Visit ShopBakerHughes</a>
                <p style="margin-top: 1ppx;">User ID: <strong>${ctx.Sso}</strong>.</p>
                <p style="margin-top: 5px;">Access type: <strong>OFS Order tracking</strong>.</p>
                <p style="margin-top: 5px;"> Access customized product pricing and information.</p>
                <p style="margin-top: 5px;"> Place orders, submit and manage quotes.</p>
                <p style="margin-top: 5px;">Track your order status and order history
                                            Save favorite items to personal lists.</p>


                <h6 style="margin-top: 5px; font-size: 14px;"><strong>Where can I find help?</strong></h6>
                <a href="mailto:${ctx.supportMail}">shopBakerHughesSupport@bakerhughes.com</a>
                <p style="margin-top: 5%;">Best regards,</p>
                <p>ShopBakerHughes Support team</p>
            </div>
        </div>
    </div>
</body>

</html>