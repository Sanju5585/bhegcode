<!DOCTYPE html>
<html>
  <head>
   <style>
* {
color: #05322b;
font-family: 'Poppins','Lucida Sans'; 
} 
</style>
  <head/>
  <body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0" style="background-color: #e9e9e9;font-family:arial, sans-serif;color:#313337">
    <center>
      <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" id="bodyTable"><tbody><tr><td align="center" id="bodyCell" style="font-size: 14px;font-family: arial, sans-serif;color: #313337">
              <table border="0" cellpadding="0" cellspacing="0" style="width:600px;background-color: #ffffff;"><tr><td style="font-size: 14px;font-family: arial, sans-serif;color: #313337">
      <!-- GE logo -->
                <table>
                  <tr>
                    <td style="font-family: arial, sans-serif;color: #313337;font-size: 14px">
                      <img src="$ctx.bhgeBasePath/assets/_ui/responsive/theme-lambda/images/plain-banner.png" width="1024" />
                    </td>
                  </tr>
                  </table><!-- Main content -->
                    <table style="width:100%; color: #868686; padding-right:20px;padding-left:20px;">
                      <tr><!-- <td width="20" style="font-family: arial, sans-serif;color: #313337"/> -->
                        <td style="font-family: arial, sans-serif;color: #868686;width: 100%;font-size: 14px">
                        <table style="width:97%">
                          <tr>
                            <td height="20" style="font-family: arial, sans-serif;color: #868686;font-size: 14px"/>
                          </tr>
                          <tr>
                            <td style="color: #05322b;font-family: 'Poppins','Lucida Sans';font-size: 14px">Dear Digital Solutions Store Support and Customer Care ,</td>
                          </tr>
                          <tr>
                            <td height="20" style="font-family: arial, sans-serif;color: #868686;font-size: 14px"/>
                          </tr>
                          <tr>
                            <td style="color: #05322b;font-family: 'Poppins','Lucida Sans'; font-size: 14px">Below are the list of error detected within the Digital Solutions Store Hybris/SAP interface since the last time this report was provided. These errors are not catastrophic, but may be impacting the user experience. Attached is the same information in XLS format.</td>
                          </tr>
                          <tr>
                            <td height="20" style="font-family: arial, sans-serif;color: #868686;font-size: 14px"/>
                          </tr>
                          <tr>
                            <td style="color: #05322b;font-family: 'Poppins','Lucida Sans'; font-size: 14px">Please take immediate action to investigate and reslove these issues.</td>
                          </tr>
                          <tr>
                            <td height="20" style="font-family: arial, sans-serif;color: #868686;font-size: 14px"/>
                          </tr>
                        </table>
                      </td>
                    </tr>
                    <tr>
                    <td style="width: 100%;font-size: 14px">
                      <table class="xls-table" style="border: 1px solid black;background-color: #e1e2e5;width: 100%;border-collapse: collapse;font-family: arial">
                        <tr>
                          <th style="text-align: center;background-color: #028474;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: 'Poppins','Lucida Sans';color:#FFFFFF;width:15%"> Error date</th>
                          <th style="text-align: center;background-color: #028474;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: 'Poppins','Lucida Sans'; color:#FFFFFF;width:15%"> Error time</th>
                          <th style="text-align: center;background-color: #028474;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: 'Poppins','Lucida Sans';color:#FFFFFF;width:18%"> Error Category</th>
                          <th style="text-align: center;background-color: #028474;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: 'Poppins','Lucida Sans';color:#FFFFFF;width:18%"> Error Message</th>                          
                          <th style="text-align: center;background-color: #028474;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: 'Poppins','Lucida Sans';color:#FFFFFF;width:18%"> User email address</th>
                          
                          <th style="text-align: center;background-color: #028474;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: 'Poppins','Lucida Sans';color:#FFFFFF;width:18%"> User sold to</th>
                        </tr>
                        <tr>
		    #foreach( $entry in $ctx.gEEdgePeriodicErrorLst)
			<tr>
                          <td style="text-align: center;border: 1px solid black;border-collapse: collapse;font-size: 14px;color: #05322b;font-family: 'Poppins','Lucida Sans';width:15%;word-break: break-all">${entry.errorDate}</td>
                          <td style="text-align: center;border: 1px solid black;border-collapse: collapse;font-size: 14px;color: #05322b;font-family: 'Poppins','Lucida Sans';width:15%;word-break: break-all">${entry.errorTime}</td>
                          <td style="text-align: center;border: 1px solid black;border-collapse: collapse;font-size: 14px;color: #05322b;font-family: 'Poppins','Lucida Sans';width:18%;word-break: break-all">${entry.errorCategory}</td>
                          <td style="text-align: center;border: 1px solid black;border-collapse: collapse;font-size: 14px;color: #05322b;font-family: 'Poppins','Lucida Sans';width:18%;word-break: break-all">
								#if("$!{entry.errorMsg}" == "" )
									<p style="display:none"></p>
								#else
									${entry.errorMsg}<br/>
								#end</td>
                          <td style="text-align: center;border: 1px solid black;border-collapse: collapse;font-size: 14px;color: #05322b;font-family: 'Poppins','Lucida Sans';width:18%;word-break: break-all">${entry.userEmail}</td>
                          <td style="text-align: center;border: 1px solid black;border-collapse: collapse;font-size: 14px;color: #05322b;font-family: 'Poppins','Lucida Sans';width:18%;word-break: break-all">${entry.soldToId}</td>
                        </tr>
		     #end
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td height="20" style="font-family: arial, sans-serif;color: #313337;font-size: 14px"/>
                  </tr>
                </table>
               
                
              </td>
            </tr>
          </table>
        </td>
      </tr></tbody></table></center>

</body>
</html>
