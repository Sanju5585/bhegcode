												   <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Name</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Product Type</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial; color:#313337;width:40%">Description</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Catalog</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Time Created</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Time Modified</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Hybris Status</th>
												  <th style="text-align: center;background-color: #B6D4D5;border: 1px solid black;border-collapse: collapse;font-size: 14px;font-family: arial;color:#313337;width:20%">Lead Time</th>

												</tr>
												#foreach($entry in $ctx.materialPushDataList )
