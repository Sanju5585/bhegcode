<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopBakerHughes</title>
    <style>
        a {
            color: #121212;
        }

        .container {
            margin-left: 3%;
        }

        .img-center {
            margin-left: 25%;
        }

        button {
            background-color: #02A783;
            color: #FFFFFF;
        }

        button:hover {
            color: white;
        }

        h6 {
            font-size: 18px;
        }
        a{
        	color: black;
        }

        .content {
            border: 1px solid #E2E2E2;
            margin-right: 25%;
            margin-left: 15%;
            background-image: url("$ctx.bhgeBasePath/assets/_ui/responsive/theme-lambda/images/OFS_Email_Background.png");
            background-repeat: no-repeat;
            background-position-x: 350px;
            background-position-y: 10px;
            background-size: 50%;
        }

        p {
            font-size: 18px;
            font-family: Poppins;
            font-style: Regular;
            line-height: 20x;
            color: #121212;
        }

        .button {
            background-color: #02A783;
            border-radius: 4px;

            padding: 10px 22px;
            text-align: center;
            text-decoration: none;
            font-size: 12px;
            margin: 2px 0px;
            cursor: pointer;
            font-family: Poppins;
            color: #FFFFFF !important;
        }

        h5 {
            text-align: center;
            font-size: 24px;
            color: #506C65;
        }

        @media only screen and (max-width: 850px) {
            p {
                font-size: 16px;
            }

            h5 {
                font-size: 18px;
                color: #506C65;
            }

            .responsive {
                width: 202px;
                height: 60px;
            }

            .content {
                border: none;
                background-color: #E5E5E5;
                margin-left: 5%;
            }
        }
    </style>
</head>

<body>
    <div class="container" style="margin-left:5%;">
        <div class="content">
            <div class="img-center mb-4">
                <img src="$ctx.bhgeBasePath/assets/_ui/responsive/theme-lambda/images/OFS_Email_Header.png" width="383px" height="112px"
                    class="responsive" />
            </div>
            <h5>Verify your email</h5>
            <div class="container" style="margin-top: 10px;">
                <h6 style="margin-top: 5%; font-size: 18px;"><strong>Dear ${ctx.userName},</strong></h6>
                <p>We have received a request to create an account to ShopBakerHughes.</p>
                <a href="${ctx.url}" class="button">Verify my Email</a>
		<br>
		<br><br>
                <p class="mt-4">This email expires in 72 hours, you can click here to. <a href="${ctx.resendUrl}"> Resend
                        confirmation email</a>
                </p>
                <p style="margin-top: 6px;"> If you didn't request for this access, please <a href="${ctx.cancelUrl}">click here</a>.</p>

                <h6 class="mt-4"><strong>Where can I find help?</strong></h6>
                <a href="mailto:${ctx.supportMail}">Contact support</a>

                <p style="margin-top: 5%;">Best regards,</p>
                <p>ShopBakerHughes Support team</p>
            </div>
        </div>
    </div>
</body>

</html>