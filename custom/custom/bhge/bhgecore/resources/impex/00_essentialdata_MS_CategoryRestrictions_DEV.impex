# ImpEx for Importing Category Classifications 
$classCatalogVersion=catalogversion(catalog(id[default='ERP_CLASSIFICATION_HYB']),version[default='ERP_IMPORT'])[unique=true,default='ERP_CLASSIFICATION_HYB:ERP_IMPORT']
$classSystemVersion=systemVersion(catalog(id[default='ERP_CLASSIFICATION_HYB']),version[default='ERP_IMPORT'])[unique=true]

#Level 2
INSERT_UPDATE ClassificationClass;$classCatalogVersion;allowedPrincipals(uid)[mode=append];code[unique=true]
