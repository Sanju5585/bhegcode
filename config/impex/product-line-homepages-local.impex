# Local product-line home CMS pages (Online catalog)
# Spartacus requests pageLabelOrId=/panametrics and /druck
$contentCatalog=bhgeContentCatalog
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Online])[default=$contentCatalog:Online]

INSERT_UPDATE PageTemplate;$contentCV[unique=true];uid[unique=true];name;frontendTemplateName;restrictedPageTypes(code);active[default=true]
;;PanaHomepageTemplate;Panametrics Home Page Template;layout/landingLayout2Page;ContentPage
;;DruckHomepageTemplate;Druck Home Page Template;layout/landingLayout2Page;ContentPage
;;WaygateHomepageTemplate;Waygate Home Page Template;layout/landingLayout2Page;ContentPage

INSERT_UPDATE ContentPage;$contentCV[unique=true];uid[unique=true];name;masterTemplate(uid,$contentCV);label;defaultPage[default='true'];approvalStatus(code)[default='approved'];homepage[default='false']
;;PanaHomepage;Panametrics Home Page;PanaHomepageTemplate;/panametrics
;;DruckHomepage;Druck Home Page;DruckHomepageTemplate;/druck
;;WaygateHomepage;Waygate Home Page;WaygateHomepageTemplate;/waygateHomepage

INSERT_UPDATE ContentSlotName;name[unique=true];template(uid,$contentCV)[unique=true][default='PanaHomepageTemplate'];validComponentTypes(code);compTypeGroup(code)
;SiteLogo;;;logo
;HeaderLinks;;;headerlinks
;SearchBox;;;searchbox
;MiniCart;;;minicart
;NavigationBar;;;navigation
;BodyContent;;;wide
;Footer;;;footer
;TopHeaderSlot;;;wide
;BottomHeaderSlot;;;wide
;PlaceholderContentSlot;;;

INSERT_UPDATE ContentSlotForTemplate;$contentCV[unique=true];uid[unique=true];position[unique=true];pageTemplate(uid,$contentCV)[unique=true][default='PanaHomepageTemplate'];contentSlot(uid,$contentCV)[unique=true];allowOverwrite
;;SiteLogo-PanaHomepage;SiteLogo;;SiteLogoSlot;true
;;HomepageLink-PanaHomepage;HomepageNavLink;;HomepageNavLinkSlot;true
;;NavigationBar-PanaHomepage;NavigationBar;;NavigationBarSlot;true
;;MiniCart-PanaHomepage;MiniCart;;MiniCartSlot;true
;;Footer-PanaHomepage;Footer;;FooterSlot;true
;;HeaderLinks-PanaHomepage;HeaderLinks;;HeaderLinksSlot;true
;;SearchBox-PanaHomepage;SearchBox;;SearchBoxSlot;true
;;TopHeaderSlot-PanaHomepage;TopHeaderSlot;;TopHeaderSlot;true
;;BottomHeaderSlot-PanaHomepage;BottomHeaderSlot;;BottomHeaderSlot;true
;;PlaceholderContentSlot-PanaHomepage;PlaceholderContentSlot;;PlaceholderContentSlot;true

INSERT_UPDATE ContentSlotName;name[unique=true];template(uid,$contentCV)[unique=true][default='DruckHomepageTemplate'];validComponentTypes(code);compTypeGroup(code)
;SiteLogo;;;logo
;HeaderLinks;;;headerlinks
;SearchBox;;;searchbox
;MiniCart;;;minicart
;NavigationBar;;;navigation
;BodyContent;;;wide
;Footer;;;footer
;TopHeaderSlot;;;wide
;BottomHeaderSlot;;;wide
;PlaceholderContentSlot;;;

INSERT_UPDATE ContentSlotForTemplate;$contentCV[unique=true];uid[unique=true];position[unique=true];pageTemplate(uid,$contentCV)[unique=true][default='DruckHomepageTemplate'];contentSlot(uid,$contentCV)[unique=true];allowOverwrite
;;SiteLogo-DruckHomepage;SiteLogo;;SiteLogoSlot;true
;;HomepageLink-DruckHomepage;HomepageNavLink;;HomepageNavLinkSlot;true
;;NavigationBar-DruckHomepage;NavigationBar;;NavigationBarSlot;true
;;MiniCart-DruckHomepage;MiniCart;;MiniCartSlot;true
;;Footer-DruckHomepage;Footer;;FooterSlot;true
;;HeaderLinks-DruckHomepage;HeaderLinks;;HeaderLinksSlot;true
;;SearchBox-DruckHomepage;SearchBox;;SearchBoxSlot;true
;;TopHeaderSlot-DruckHomepage;TopHeaderSlot;;TopHeaderSlot;true
;;BottomHeaderSlot-DruckHomepage;BottomHeaderSlot;;BottomHeaderSlot;true
